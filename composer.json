{
    "name": "topstats/laravel",
    "description": "Official TopStats Analytics integration for Laravel, plus a PSR-15 middleware for Symfony, Slim and friends.",
    "license": "MIT",
    "type": "library",
    "keywords": ["topstats", "analytics", "laravel", "psr-15", "middleware"],
    "homepage": "https://topstats.gg",
    "support": {
        "docs": "https://docs.topstats.gg/docs/analytics",
        "issues": "https://github.com/top-stats/analytics-laravel-integration/issues"
    },
    "require": {
        "php": ">=8.1",
        "topstats/analytics": "*",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "illuminate/http": "^10.0 || ^11.0",
        "illuminate/routing": "^10.0 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0",
        "nyholm/psr7": "^1.8"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/top-stats/analytics-php-sdk" }
    ],
    "autoload": {
        "psr-4": { "TopStats\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "TopStats\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["TopStats\\Laravel\\TopStatsServiceProvider"]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
